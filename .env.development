# Development environment — loaded when NODE_ENV=development (or unset).
# Bun loads .env first, then this file on top.

# Verbose fetch logging — prints URL, method, headers for every fetch/http call.
# Equivalent to BUN_CONFIG_VERBOSE_FETCH=1 but with curl-style output.
BUN_CONFIG_VERBOSE_FETCH=curl

# Force ANSI color on in terminal output, even if NO_COLOR is set elsewhere.
# Bun.color(..., "ansi") respects this — returns escape strings, not "".
FORCE_COLOR=1

# Prepend --hot to all bun invocations — enables hot module reloading for
# `bun run` scripts. Makes `bun run render-mermaid.ts` pick up .mmd edits
# without re-invoking. (Note: only affects watch-mode scripts.)
BUN_OPTIONS=--hot
