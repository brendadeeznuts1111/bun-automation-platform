---
title: "Bun Automation Platform v1.3.14+ — Updated Architecture"
---
flowchart TB
    subgraph BuildTime["Build-Time & Runtime Configuration"]
        A[".env files loaded automatically"] --> B["App-level vars: MASTER_KEY, CSRF_SECRET, NODE_ENV, PROXY_POOL_URL, DEFAULT_THEME_COLOR"]
        A --> C["Bun-specific vars: NODE_TLS_REJECT_UNAUTHORIZED, BUN_CONFIG_VERBOSE_FETCH, BUN_RUNTIME_TRANSPILER_CACHE_PATH, TMPDIR, NO_COLOR, FORCE_COLOR, BUN_CONFIG_MAX_HTTP_REQUESTS, BUN_CONFIG_NO_CLEAR_TERMINAL_ON_RELOAD, DO_NOT_TRACK, BUN_OPTIONS"]
        C --> D["Affect Bun runtime: HTTP concurrency, logging, caching, temp dir, colors, crash reports, CLI defaults"]
        B --> E["Injected via --define: FEATURE_FLAGS, MAX_WORKERS, SCREENSHOT_QUALITY"]
        E --> F["Compiled standalone executable (bun build --compile) using native 'using' (v1.3.14)"]
    end

    subgraph Frontend["Agent Dashboard (HTML + CSS + JS)"]
        G[Login Page] --> H[Dashboard UI]
        H --> I["Task Submission Form (URL, creds, location, proxy)"]
        H --> J["Task List with progress (polling or WebSocket)"]
        H --> K["Session Detail Modal (logs, screenshot, cookies)"]
        H --> L["Credential Management (add/edit/delete) – uses Bun.secrets (optional)"]
        H --> M["Live Control (canvas + WebSocket) – uses Bun.serve WebSocket"]
        H --> N["Theme Customization – uses Bun.color to generate primary/light/dark colors"]
        H --> O["Verification Panel (IP, UA, fingerprint – from request headers)"]
    end

    subgraph Server["Main Bun Server (Bun.serve – built-in, stable)"]
        P["HTTPS/TLS (Bun.serve tls) – shared SSL_CTX cache (v1.3.14)"] --> Q["Request routing with URLPattern (v1.3.4)"]
        Q --> R{"CSRF protection (Bun.CSRF – stable)"}
        R -->|Valid| S[Process request]
        R -->|Invalid| T[403 Forbidden]
        S --> U["/login – Bun.password (stable) – verify agent"]
        S --> V["/task – create task, spawn worker via Bun.spawn (stable)"]
        S --> W["/tasks, /sessions – return data from SQLite"]
        S --> X["/session/:id/refresh, /close – state changes (CSRF protected)"]
        S --> Y["/credentials – list/add/delete (Bun.secrets or encrypted SQLite)"]
        S --> Z["/verify – return IP, UA, fingerprint from request"]
        S --> AA["/theme – update agent theme (uses Bun.color for validation & transformation)"]
        S --> AB["/live – upgrade to WebSocket (Bun.serve WebSocket) – perMessageDeflate fix (v1.3.14)"]
    end

    subgraph Workers["Task Workers (Bun.spawn – stable)"]
        AC["Worker process (bun worker.ts)"] --> AD["Read taskId from argv"]
        AD --> AE["Launch Bun.WebView (v1.3.12 – experimental)"]
        AE --> AF["Override User-Agent via CDP (view.cdp('Network.setUserAgentOverride'))"]
        AE --> AG["Override Geolocation via CDP (view.cdp('Emulation.setGeolocationOverride'))"]
        AE --> AH["Use proxy from task (backend.argv)"]
        AF --> AI["Navigate, type, click, waitForSelector – using native 'using' for WebView cleanup (v1.3.14)"]
        AI --> AJ["Capture session: cookies, localStorage, sessionStorage"]
        AJ --> AK["Screenshot with Bun.Image (v1.3.14 – stable)"]
        AK --> AL["Process image: resize, convert to WebP, generate ThumbHash"]
        AL --> AM["Extract dominant color via Bun.color (v1.1.30 – stable) for placeholder"]
        AM --> AN["Store session + screenshot + color metadata in SQLite"]
        AC --> AO["IPC: send progress updates (10%, 50%, 100%) to parent"]
        AO --> AP["Parent updates task status in DB"]
        AC --> AQ["Exit (success/failure) – onExit handler catches crashes"]
        AC --> AR["Optionally use process.execve to replace worker process (v1.3.14)"]
    end

    subgraph Scheduling["Scheduled Jobs (Bun.cron – v1.3.11, stable)"]
        AS["In-process cron: */5 * * * *"] --> AT[Fetch active sessions]
        AT --> AU["Call lightweight API (e.g., getAccountInfo) with session cookie – shared SSL_CTX (v1.3.14)"]
        AU --> AV{Valid?}
        AV -->|Yes| AW[Update last_healthy]
        AV -->|No| AX["Spawn refresh worker (Bun.spawn)"]
        AY["OS-level cron (optional): Bun.cron(path, schedule, title)"] --> AZ[Run collector script every 2 hours]
        AZ --> BA[Collect odds/data via direct API calls – shared SSL_CTX]
    end

    subgraph Data["Data Layer"]
        BB["SQLite (bun:sqlite – stable)"] --> BC["Tasks (status, progress, encrypted creds)"]
        BB --> BD["Sessions (cookies, storage, screenshot path, theme colors)"]
        BB --> BE["Credentials (encrypted with MASTER_KEY via AES-256-GCM)"]
        BB --> BF["Audit logs (agent_id, action, timestamp, details)"]
        BG["File system / S3 (Bun.write, Bun.file – stable)"] --> BH["Screenshots (JPEG/WebP), ThumbHash placeholders"]
    end

    subgraph Security["Security Layer"]
        BI["Bun.CSRF (stable)"] --> BJ["Generate token bound to dashboard session cookie, verify on state changes"]
        BK["Bun.CookieMap (v1.2.7, stable)"] --> BL["Dashboard session cookie (httpOnly, secure, sameSite)"]
        BM["Bun.password (stable)"] --> BN["Hash/verify agent passwords (Argon2id default)"]
        BO["Bun.secrets (experimental, v1.3.5?)"] --> BP["Store master key or per-site credentials in OS keychain (local dev)"]
        BQ["App-level Environment Variables"] --> BR["MASTER_KEY, CSRF_SECRET, etc. – used for encryption and config"]
        BS["Bun.color (v1.1.30, stable)"] --> BT["Validate & transform theme colors; generate placeholder colors for screenshots"]
    end

    subgraph LiveControl["Live Control (WebSocket – Bun.serve WebSocket, stable)"]
        BU["WebSocket endpoint /live"] --> BV["Upgrade to WebSocket (Bun.upgrade) – perMessageDeflate: false supported (v1.3.14)"]
        BV --> BW["Stream screenshots (base64 JPEG) from active WebView (view.screenshot)"]
        BV --> BX["Forward mouse/keyboard events to WebView (view.click, view.type, view.press, view.evaluate)"]
        BX --> BY["Update WebView via CDP (view.cdp) for advanced interactions"]
        BZ["Bun.Terminal (Windows ConPTY – v1.3.14)"] --> CA["For interactive debugging / CAPTCHA solving from dashboard on Windows"]
    end

    subgraph Platform["Platform & Signal Handling"]
        CB["FreeBSD & Android builds (v1.3.14)"] --> CC[Deploy to more environments]
        CD["SIGHUP / SIGBREAK signal handling on Windows (v1.3.14)"] --> CE[Graceful shutdown on console close]
    end

    subgraph Gaps["Gaps & Considerations (to address)"]
        CF["Missing features"] --> CG["Rate limiting (add bun-rate-limiter)"]
        CF --> CH["Retry logic (exponential backoff on failures)"]
        CF --> CI["Circuit breaker (skip site after N failures)"]
        CF --> CJ["Structured logs (pino) & Prometheus metrics"]
        CF --> CK["Distributed locking (Redis) for multi-instance cron"]
        CF --> CL["Containerization (Docker) & CI/CD"]
        CF --> CM["Database migrations (use migrate tool)"]
        CF --> CN["Real-time updates via WebSocket (partially implemented)"]
        CF --> CO["Multi-account support (per profile)"]
        CF --> CP["Audit trail (partially implemented, expand)"]
        CF --> CQ["Use Bun.color for dynamic favicon generation (optional)"]
        CF --> CR["Use process.execve for zero-downtime worker updates (optional)"]
    end

    %% Connections
    Frontend -->|HTTP/HTTPS| Server
    Server --> Workers
    Server --> Scheduling
    Server --> Data
    Server --> Security
    Server --> LiveControl
    Workers --> Data
    Scheduling --> Workers
    Scheduling --> Data
    BuildTime --> Server
    BuildTime --> Workers
    Security --> Server
    Security --> Workers
    LiveControl --> Workers
    Platform --> Server
    Platform --> Workers

    %% Styling
    classDef bun fill:#b3d9ff,stroke:#333,stroke-width:1px;
    classDef security fill:#ffb3b3,stroke:#333,stroke-width:1px;
    classDef data fill:#b3ffb3,stroke:#333,stroke-width:1px;
    classDef gap fill:#ffcccc,stroke:#ff0000,stroke-width:2px,stroke-dasharray: 5 5;
    classDef frontend fill:#f9d5e5,stroke:#333,stroke-width:1px;
    classDef stable fill:#d4edda,stroke:#28a745,stroke-width:1px;
    classDef experimental fill:#ffe5cc,stroke:#ff8800,stroke-width:1px;
    classDef new fill:#ffd700,stroke:#333,stroke-width:2px;

    class AE,AK,AL,AM,AN,AS,AT,AU,AV,AW,AX,AY,AZ,BA,BI,BJ,BK,BL,BM,BN,BO,BP,BQ,BR,BS,BT,BU,BV,BW,BX,BY,BZ,CA bun;
    class BI,BJ,BK,BL,BM,BN,BO,BP,BQ,BR,BS,BT security;
    class BB,BG data;
    class CF,CG,CH,CI,CJ,CK,CL,CM,CN,CO,CP,CQ,CR gap;
    class G,H,I,J,K,L,M,N,O frontend;
    class P,Q,R,S,T,U,V,W,X,Y,Z,AA,AB,AC,AD,AO,AP,AQ,AS,AT,AU,AV,AW,AX,AY,AZ,BA,BT,BU,BV,BW,BX,BY stable;
    class AE,BO experimental;
    class A,B,C,D,E,F config;
    class AR,BZ,CB,CD,CE,CR,BR,BU,BV,BW,BX,BY new;
