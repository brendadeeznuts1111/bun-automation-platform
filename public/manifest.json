  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Home",
      "description": "Open the main dashboard",
      "url": "/dashboard?source=shortcut",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "API Reference",
      "short_name": "API",
      "description": "Browse all API endpoints",
      "url": "/dashboard?source=shortcut#api-reference",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Health Check",
