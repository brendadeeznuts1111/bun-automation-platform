{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Server (src/server.ts)",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--inspect-wait"],
      "program": "${workspaceFolder}/src/server.ts",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopOnEntry": false
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Tests (bun test)",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["test", "--inspect-wait"],
      "program": "${workspaceFolder}/tests/server.test.ts",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Bun Inspector",
      "port": 6499,
      "address": "127.0.0.1"
    }
  ]
}
