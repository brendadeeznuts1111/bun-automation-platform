{
  "name": "bun-automation-platform",
  "private": true,
  "bin": {
    "render-mermaid": "render-mermaid.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "start": "bun run src/server.ts",
    "dev": "bun --hot src/server.ts",
    "build": "bun build --compile --minify src/server.ts --outfile server",
    "seed": "bun run seed-agent.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "puppeteer": "^23 || ^24 || ^25"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  }
}
