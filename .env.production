# Production environment — loaded when NODE_ENV=production.
# Bun loads .env first, then this file on top.

# Raise the concurrent HTTP request cap from the default 256.
# Safe in production where fetch/bun install workloads are heavier.
BUN_CONFIG_MAX_HTTP_REQUESTS=512

# Disable ANSI color output — production logs go to aggregators that
# don't want escape codes. Bun.color(..., "ansi") returns "" when this is set.
NO_COLOR=1

# Disable crash report uploads to bun.report and telemetry.
DO_NOT_TRACK=1

# Disable the runtime transpiler cache — in containers the cache directory
# may not persist between runs, so caching just adds write overhead.
# "0" turns it off entirely.
BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
